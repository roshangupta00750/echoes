; ECHOES: every level, the ghosts of your past runs come back.
config_version=5

[application]

config/name="ECHOES"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/art/icon.png"
boot_splash/bg_color=Color(0.02, 0.01, 0.05, 1)
boot_splash/show_image=false
config/quit_on_go_back=false

[display]

window/size/viewport_width=384
window/size/viewport_height=216
window/size/window_width_override=1536
window/size/window_height_override=864
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

sensors/enable_accelerometer=true
sensors/enable_gravity=true
sensors/enable_gyroscope=true

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.02, 0.01, 0.05, 1)
textures/vram_compression/import_etc2_astc=true
